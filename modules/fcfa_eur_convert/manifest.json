{
  "id": "fcfa_eur_convert",
  "version": "1.0.0",
  "title": "Convert FCFA (XOF) and EUR",
  "description": "Converts between XOF and EUR using the fixed peg.",
  "language": "en",
  "intents": [
    "convert fcfa to eur",
    "convertir fcfa en euro",
    "xof eur",
    "fcfa euro"
  ],
  "inputs": {
    "type": "object",
    "required": [
      "amount",
      "direction"
    ],
    "properties": {
      "amount": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000000000
      },
      "direction": {
        "type": "string",
        "enum": [
          "XOF_TO_EUR",
          "EUR_TO_XOF"
        ]
      },
      "rate_xof_per_eur": {
        "type": "number",
        "default": 655.957,
        "minimum": 1,
        "maximum": 1000000
      }
    }
  },
  "outputs": {
    "type": "object",
    "required": [
      "result"
    ],
    "properties": {
      "result": {
        "type": "number"
      },
      "currency": {
        "type": "string"
      }
    }
  },
  "permissions": [],
  "limits": {
    "timeout_ms": 200,
    "memory_kb": 8192,
    "output_max_bytes": 4096
  },
  "examples": [
    {
      "input": {
        "amount": 655957,
        "direction": "XOF_TO_EUR"
      },
      "output": {
        "result": 1000,
        "currency": "EUR"
      }
    },
    {
      "input": {
        "amount": 1000,
        "direction": "EUR_TO_XOF"
      },
      "output": {
        "result": 655957,
        "currency": "XOF"
      }
    }
  ],
  "properties": [
    {
      "name": "non_negative",
      "expr": "output.result >= 0"
    }
  ],
  "tolerance": {
    "relative": 1e-9,
    "absolute": 1e-9
  },
  "view": {
    "type": "keyvalue",
    "labels": {
      "result": "Result",
      "currency": "Currency"
    }
  },
  "assumptions": [
    "Fixed peg 655.957 XOF per EUR (user can override the rate)."
  ],
  "provenance": {
    "origin": "seed",
    "model": null,
    "created_at": "2026-10-29T00:00:00Z",
    "verification": "VERIFIED"
  },
  "sha256": "8fa25f2cef46d2ca0607a8444ba59d986683d57ed7bf6f5d2448a9c3a6791981"
}