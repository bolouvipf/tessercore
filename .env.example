# Copy to .env and fill. Never commit .env
# LLM gateway — Meta models only (see MODEL_ALLOWLIST)
LLM_BASE_URL=https://api.baseten.co/v1
LLM_API_KEY=sk-...
LLM_MODEL_ROUTER=meta-models/muse-spark-open-1026
LLM_MODEL_GEN_A=meta-models/muse-spark-open-1026
LLM_MODEL_GEN_B=meta-models/muse-spark-open-1026
MODEL_ALLOWLIST=meta-models/muse-spark-open-1026,meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# Server
PORT=8787
REGISTRY_DIR=./server/data
SIGN_PRIVATE_KEY_HEX=
SIGN_PUBLIC_KEY_HEX=
